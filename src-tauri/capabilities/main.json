{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "What the app's own webview may ask the Rust side to do. Granted to that one webview, not to its window, so a second webview placed in the same window gets nothing.",
  "webviews": ["main"],
  "permissions": [
    "allow-vm-start",
    "allow-vm-stop",
    "allow-vm-status",
    "allow-vm-frame",
    "allow-device-name",
    "allow-window-buttons",
    "allow-window-drag",
    "allow-window-minimize",
    "allow-window-toggle-maximize",
    "allow-window-close",
    "allow-window-tint",
    "allow-key-save",
    "allow-key-exists",
    "allow-key-forget",
    "allow-models-list",
    "allow-search-test",
    "allow-chat-send",
    "allow-chat-stop"
  ]
}
